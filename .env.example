# Smart Student Part-Time Job Management System Environment Variables
PORT=5000
SECRET_KEY=smart_student_job_system_secret_key_2026_prod
JWT_SECRET_KEY=smart_student_job_jwt_secret_key_2026

# Database Configuration (Defaults to SQLite if MySQL is not available)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=student_job_db

# SMTP Configuration for 6-Digit Email OTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password

# Cloudinary Configuration for Job Image Uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend API URL (Set in Vercel Environment Variables if backend is hosted separately)
VITE_API_BASE_URL=
