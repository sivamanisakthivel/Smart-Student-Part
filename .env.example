# Smart Student Part-Time Job Management System Environment Variables
PORT=5000
SECRET_KEY=replace-with-your-own-value
JWT_SECRET_KEY=replace-with-your-own-value

# Database Configuration (Defaults to SQLite if MySQL is not available)
MYSQL_HOST=your_database_host
MYSQL_PORT=3306
MYSQL_USER=your_database_user
MYSQL_PASSWORD=replace-with-your-own-value
MYSQL_DB=your_database_name

# SMTP Configuration for 6-Digit Email OTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@example.com
SMTP_PASSWORD=replace-with-your-own-value

# Cloudinary Configuration for Job Image Uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace-with-your-own-value
CLOUDINARY_API_SECRET=replace-with-your-own-value

# Frontend API URL (Set in Vercel Environment Variables if backend is hosted separately)
VITE_API_BASE_URL=
